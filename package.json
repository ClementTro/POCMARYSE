{
  "name": "maryse-and-co",
  "private": true,
  "version": "1.1.1",
  "description": "Maryse & Co — le carnet de cuisine familial de Maryse, en application web.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-404.mjs",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/verifier-utf8.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typo:fr": "node scripts/typographie-fr.mjs",
    "publier": "node scripts/publier.mjs",
    "annuler": "node scripts/annuler.mjs",
    "diagnostic": "node scripts/diagnostic.mjs",
    "verifier-site": "node scripts/verifier-site.mjs",
    "mode-dev": "node scripts/mode.mjs dev",
    "mode-asso": "node scripts/mode.mjs asso"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@hookform/resolvers": "^6.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "i18next": "^26.5.12",
    "i18next-browser-languagedetector": "^8.2.4",
    "lucide-react": "^1.65.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
